# الگوی متغیرهای محیطی — تکلیف ۳
#
# این فایل نمونه است: هیچ راز واقعی اینجا نیست و نباید گذاشته شود.
# فایل واقعی را با نام .env کنار همین فایل بساز؛ .env در .gitignore است.
# قاعدهٔ تکلیف: هیچ رمز/API key/توکن واقعی در نوت‌بوک، JSON یا فایل دیتابیس ننویس.

# --- بذر و مسیرها (این‌ها را عوض نکن) ---
DAY3_SEED=20261015
DAY3_DATA_DIR=./datasets
DAY3_DB_PATH=./day3.sqlite
DAY3_RESOURCES_DIR=./resources
DAY3_ARTIFACTS_DIR=./artifacts

# --- مدل embedding (نسخهٔ قفل‌شده) ---
DAY3_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
DAY3_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
DAY3_MODEL_DIR=./resources/embedding_model

# --- ارائه‌دهنده‌های فرضی ---
# دامنهٔ .invalid عمداً انتخاب شده تا هیچ فراخوانی واقعی ممکن نباشد.
# روی ماشین واقعی، مقدارها فقط از محیط/secret store خوانده می‌شوند، نه از کد.
DAY3_PROVIDER_A_BASE_URL=https://provider-a.invalid/v1
DAY3_PROVIDER_A_MODEL_ID=fixture-model-a
DAY3_PROVIDER_A_API_KEY=placeholder-not-a-real-key

DAY3_PROVIDER_B_BASE_URL=https://provider-b.invalid/v1
DAY3_PROVIDER_B_MODEL_ID=fixture-model-b
DAY3_PROVIDER_B_API_KEY=placeholder-not-a-real-key

# --- اجرای آزمون‌ها ---
DAY3_RUN_MODE=fixture           # fixture | live  (live در این تکلیف استفاده نمی‌شود)
DAY3_LOG_LEVEL=INFO
